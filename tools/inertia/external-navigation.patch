@@ -0,0 +1,280 @@
+import { afterEach, beforeEach, describe, expect, it, vi } from 'vitest'
+import type { Page } from '../src/types'
+
+type CoreModules = {
+  Request: typeof import('../src/request').Request
+  router: typeof import('../src').router
+}
+
+const initialPage = (url = '/inertia?tab=current', props: Page['props'] = { count: 1 }): Page => ({
+  component: 'Dashboard',
+  props: { errors: {}, ...props },
+  url,
+  version: null,
+  flash: {},
+  rescuedProps: [],
+  rememberedState: {},
+})
+
+const tick = () => new Promise((resolve) => setTimeout(resolve, 0))
+
+describe('external navigation', () => {
+  let core: CoreModules
+  let windowTarget: EventTarget
+  let documentTarget: EventTarget
+  let pushState: ReturnType<typeof vi.fn>
+  let replaceState: ReturnType<typeof vi.fn>
+  let windowAddEventListener: ReturnType<typeof vi.fn>
+  let documentAddEventListener: ReturnType<typeof vi.fn>
+
+  beforeEach(async () => {
+    vi.resetModules()
+
+    windowTarget = new EventTarget()
+    documentTarget = new EventTarget()
+    pushState = vi.fn()
+    replaceState = vi.fn()
+    windowAddEventListener = vi.fn(windowTarget.addEventListener.bind(windowTarget))
+    documentAddEventListener = vi.fn(documentTarget.addEventListener.bind(documentTarget))
+
+    vi.stubGlobal(
+      'window',
+      Object.assign(windowTarget, {
+        addEventListener: windowAddEventListener,
+        removeEventListener: windowTarget.removeEventListener.bind(windowTarget),
+        dispatchEvent: windowTarget.dispatchEvent.bind(windowTarget),
+        history: { state: null, scrollRestoration: 'auto', pushState, replaceState },
+        location: new URL('https://host.test/shell?host=state'),
+        navigator: { userAgent: 'vitest' },
+        requestAnimationFrame: (callback: FrameRequestCallback) => callback(0),
+        setInterval,
+        clearInterval,
+        scrollTo: vi.fn(),
+      }),
+    )
+    vi.stubGlobal(
+      'document',
+      Object.assign(documentTarget, {
+        addEventListener: documentAddEventListener,
+        removeEventListener: documentTarget.removeEventListener.bind(documentTarget),
+        dispatchEvent: documentTarget.dispatchEvent.bind(documentTarget),
+        querySelectorAll: vi.fn(() => []),
+        getElementById: vi.fn(() => null),
+        visibilityState: 'visible',
+        hidden: false,
+      }),
+    )
+    vi.stubGlobal(
+      'CustomEvent',
+      class<T> extends Event {
+        detail: T
+
+        constructor(type: string, options?: CustomEventInit<T>) {
+          super(type, options)
+          this.detail = options?.detail as T
+        }
+      },
+    )
+
+    const [{ router }, { Request }] = await Promise.all([import('../src'), import('../src/request')])
+    core = { router, Request }
+  })
+
+  afterEach(() => {
+    vi.restoreAllMocks()
+    vi.unstubAllGlobals()
+    vi.useRealTimers()
+  })
+
+  const init = (
+    externalNavigation: {
+      navigate: (url: string) => void
+      remember?: (data: unknown, key: string) => void
+      restore?: (key: string) => unknown
+    },
+    overrides: Partial<Parameters<CoreModules['router']['init']>[0]> = {},
+  ) =>
+    core.router.init({
+      initialPage: initialPage(),
+      resolveComponent: vi.fn(async (component) => component),
+      swapComponent: vi.fn(async () => undefined),
+      externalNavigation,
+      ...overrides,
+    })
+
+  it('leaves browser history and navigation listeners entirely under host control', async () => {
+    const dispose = init({ navigate: vi.fn() })
+    await tick()
+
+    expect(pushState).not.toHaveBeenCalled()
+    expect(replaceState).not.toHaveBeenCalled()
+    expect(window.history.scrollRestoration).toBe('auto')
+    expect(windowAddEventListener.mock.calls.map(([type]) => type)).not.toContain('popstate')
+
+    dispose()
+  })
+
+  it('hands plain GET visits to the host with an absolute URL and makes no request', async () => {
+    const navigate = vi.fn()
